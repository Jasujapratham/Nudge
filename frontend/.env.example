# Copy this file to ".env" only if you want to change where the frontend
# sends its API requests. Without a .env file the app uses "/api", which the
# Vite dev server forwards to http://localhost:8080 - the usual case.

# Option A (default, nothing to do):
# VITE_API_URL=/api

# Option B: call the backend directly, relying on the backend's CORS config.
# VITE_API_URL=http://localhost:8080/api
